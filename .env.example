# Copy this file to .env and fill in the values
# cp .env.example .env

# ── Authentication mode ───────────────────────────────────────────────────────
# jwt     → use /tmp/jwt (CML workbench auto-refreshed token), fall back to CDSW_API_KEY
# api_key → use CDSW_API_KEY directly (external endpoints, NVIDIA NIM, OpenAI, etc.)
AUTH_MODE = "jwt"

# ── Option 1: Cloudera AI Inference Service (CML workbench) ──────────────────
# AUTH_MODE    = "jwt"
# CDSW_API_URL = "https://caii-serving-<id>.<domain>/namespaces/serving-default/endpoints/<endpoint-name>/openai/v1"
# CDSW_API_KEY = ""      # leave blank — /tmp/jwt is used automatically
# LLM_MODEL    = "Qwen/Qwen2.5-Coder-7B-Instruct"

# ── Option 2: NVIDIA NIM / build.nvidia.com ──────────────────────────────────
# AUTH_MODE    = "api_key"
# CDSW_API_URL = "https://integrate.api.nvidia.com/v1"
# CDSW_API_KEY = "nvapi-..."
# LLM_MODEL    = "nvidia/nemotron-super-49b-v1"

# ── Option 3: OpenAI ─────────────────────────────────────────────────────────
# AUTH_MODE    = "api_key"
# CDSW_API_URL = "https://api.openai.com/v1"
# CDSW_API_KEY = "sk-..."
# LLM_MODEL    = "gpt-4o"

# ── Active config (uncomment and fill one block above, or set values here) ───
CDSW_API_URL = ""
CDSW_API_KEY = ""
LLM_MODEL    = ""

# ── RSG / VIAVI (leave as-is unless overriding the simulator host) ────────────
# RSG_HOST     = "3.211.96.252"
# RSG_ADDRESS  = ""   # full container URL override e.g. http://<host>:8000/c/<hash>/
