# Copy this file to .env and fill in the values
# cp .env.example .env

# ── Option 1: OpenAI (recommended for demos) ──────────────────────────────────
CDSW_API_URL = "https://api.openai.com/v1"
CDSW_API_KEY = "sk-..."
LLM_MODEL    = "gpt-4o"

# ── Option 2: Cloudera ML — Nemotron 49B ──────────────────────────────────────
# CDSW_API_URL = "https://ml-<hash>.go01-dem.ylcu-atmi.cloudera.site/namespaces/serving-default/endpoints/goes---nemotron-v1-5-49b-throughput/v1"
# CDSW_API_KEY = "<JWT from CML UI>"
# LLM_MODEL    = "nvidia/llama-3.3-nemotron-super-49b-v1.5"

# ── Option 3: NVIDIA API — LLaMA 70B fallback ────────────────────────────────
# CDSW_API_URL = "https://integrate.api.nvidia.com/v1"
# CDSW_API_KEY = "nvapi-..."
# LLM_MODEL    = "meta/llama-3.1-70b-instruct"

# ── RSG / VIAVI (leave as-is unless overriding the simulator host) ────────────
# RSG_HOST     = "3.211.96.252"
# RSG_ADDRESS  = ""   # full container URL override e.g. http://<host>:8000/c/<hash>/
